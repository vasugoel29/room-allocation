# Backend API base (defaults to /api, served by the same origin / Vite dev proxy)
VITE_API_URL=
# Google Identity Services OAuth client id (same as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
# Show the developer sign-in form (local only; the backend also needs AUTH_DEV_LOGIN=true)
VITE_DEV_LOGIN=false
# Sentry browser DSN; leave empty to disable Sentry. Traces / error replays are sampled (0..1).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ON_ERROR_RATE=0.5
