# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Comma-separated browser origins allowed to call the API (the deployed frontend URL)
CORS_ORIGIN=https://cras.example.nsut.ac.in
# Seconds to let in-flight requests finish on SIGTERM before exiting (ms)
SHUTDOWN_TIMEOUT_MS=10000
# Reuse the /api/health DB check for this long (ms)
HEALTH_CACHE_MS=2000

# ---- Database -------------------------------------------------------------
# Required. Migrations run automatically at startup, before the server listens.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/roomdb

# ---- Sessions -------------------------------------------------------------
# Required. 32+ random characters; rotating it signs everyone out.
JWT_SECRET=
SESSION_TTL=12h

# ---- Google SSO -----------------------------------------------------------
# Google Identity Services OAuth client id(s), comma-separated
GOOGLE_CLIENT_ID=
# Workspace domain allowed to sign in
GOOGLE_ALLOWED_HD=nsut.ac.in
# Developer sign-in without Google (always refused when NODE_ENV=production)
AUTH_DEV_LOGIN=false

# ---- College ACL (identity, roles, permissions) ---------------------------
ACL_API_URL=https://acl-lake.vercel.app
ACL_CLIENT_ID=CRAS
ACL_CLIENT_SECRET=
# live (default) | mock (test stacks only; refused in production)
ACL_MODE=live
ACL_TIMEOUT_MS=5000
# Refresh a signed-in user's ACL snapshot when older than this; refuse sign-in past MAX_STALE if the ACL is down
ACL_REFRESH_SECONDS=900
ACL_MAX_STALE_SECONDS=43200
# How long a loaded principal is cached in memory (ms)
PRINCIPAL_CACHE_MS=30000
# Shared secret the ACL uses to push faculty-directory updates (PUT /api/internal/faculties); 32+ chars
INTERNAL_SYNC_TOKEN=

# ---- Email (booking notifications) ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CRAS — Campus Room Allocation

# ---- Abuse guard (leaky bucket; only absurd volumes are refused) ----------
# Per signed-in user (or IP): burst capacity and steady requests/second
RATE_LIMIT_API_CAPACITY=600
RATE_LIMIT_API_LEAK_PER_SEC=20
# Sign-in endpoints per IP, and per account
RATE_LIMIT_AUTH_IP_CAPACITY=300
RATE_LIMIT_AUTH_IP_LEAK_PER_SEC=5
RATE_LIMIT_AUTH_ACCOUNT_CAPACITY=20
RATE_LIMIT_AUTH_ACCOUNT_LEAK_PER_SEC=0.1
RATE_LIMIT_DISABLED=false

# ---- Observability --------------------------------------------------------
# Sentry is off when SENTRY_DSN is empty; traces are sampled (0..1)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Bearer token a Prometheus scraper must send to read /metrics; /metrics is disabled when unset
METRICS_TOKEN=
