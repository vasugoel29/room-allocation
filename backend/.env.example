DATABASE_URL=
JWT_SECRET=
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
ACL_API_URL=https://acl-lake.vercel.app
ACL_CLIENT_ID=CRAS
ACL_CLIENT_SECRET=
# Google Identity Services OAuth client id(s), comma-separated
GOOGLE_CLIENT_ID=
# Workspace domain allowed to sign in
GOOGLE_ALLOWED_HD=nsut.ac.in
# Developer sign-in without Google (refused when NODE_ENV=production)
AUTH_DEV_LOGIN=false
# Session token lifetime and ACL snapshot refresh
SESSION_TTL=12h
ACL_REFRESH_SECONDS=900
ACL_MAX_STALE_SECONDS=43200
# Shared secret the central ACL uses to push faculty-directory updates (PUT /api/internal/faculties); 32+ chars
INTERNAL_SYNC_TOKEN=
